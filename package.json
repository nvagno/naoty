{
  "name": "carnet-recherche",
  "version": "0.1.0",
  "private": true,
  "description": "Carnet de recherche numérique personnel, local",
  "author": "Ny Hasina VAGNO",
  "license": "MIT",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate && node scripts/copy-excalidraw-assets.mjs",
    "carnet": "prisma migrate deploy && next build && next start -p 3000",
    "electron:prepare": "node scripts/electron-prepare.mjs",
    "electron": "npm run electron:prepare && electron .",
    "dist": "npm run electron:prepare && electron-builder"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "local.carnet-recherche",
    "productName": "Mon Carnet de Recherche",
    "artifactName": "carnet-recherche-${version}-${arch}.${ext}",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "prisma/migrations",
        "to": "migrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Ny Hasina VAGNO",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Le carnet utilise le micro pour enregistrer des vocaux dans les notes."
      }
    },
    "afterPack": "scripts/electron-after-pack.mjs"
  },
  "desktopName": "carnet-recherche.desktop"
}
